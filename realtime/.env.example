# Piège n°8 : ces noms sont exactement ceux lus par src/config.ts.
PORT=4000
# URL interne ou publique du service web (Payload), sans slash final
PAYLOAD_URL=http://localhost:3000
# Clé API de l'utilisateur de rôle "service" créé dans /admin
PAYLOAD_API_KEY=colle-la-cle-api-ici
# Doit être IDENTIQUE à REALTIME_SECRET du service web
REALTIME_SECRET=remplace-moi-par-une-autre-longue-chaine
# Origine(s) autorisée(s) du site, séparées par des virgules
WEB_ORIGIN=http://localhost:3000
