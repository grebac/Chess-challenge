{
  "name": "chess-realtime",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "esbuild src/server.ts --bundle --platform=node --format=esm --packages=external --target=node22 --outfile=dist/server.js",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "chess.js": "1.4.0",
    "jose": "6.2.13",
    "socket.io": "4.8.4"
  },
  "devDependencies": {
    "@types/node": "22.19.9",
    "esbuild": "0.28.2",
    "socket.io-client": "4.8.4",
    "tsx": "4.23.15",
    "typescript": "5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
