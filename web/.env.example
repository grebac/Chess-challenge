# --- Base de données (Neon : utiliser l'URL de connexion directe pour les migrations manuelles) ---
DATABASE_URI=postgres://user:password@host:5432/chess

# --- Payload ---
PAYLOAD_SECRET=remplace-moi-par-une-longue-chaine-aleatoire

# --- Temps réel (doit être IDENTIQUE à la valeur du service realtime) ---
REALTIME_SECRET=remplace-moi-par-une-autre-longue-chaine
# URL publique du service realtime, lue à l'exécution (pas de NEXT_PUBLIC_ : rien à injecter au build)
REALTIME_URL=http://localhost:4000
